read -p "Enter 'y' to confirm or 'n' to cancel: " confirm

# If the user confirms, delete the files and directories permanently
if [ "$confirm" = "y" ]; then
  for FILE in "${FILES[@]}"
  do
    if [ -f "$FILE" ]; then
      rm -f "$FILE"
    elif [ -d "$FILE" ]; then
      rm -rf "$FILE"
    fi
  done
fi
